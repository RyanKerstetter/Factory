{
  "name": "factory-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev --workspace @factory/client",
    "dev:server": "npm run dev --workspace @factory/server",
    "start": "npm run build:client && concurrently -n client,server -c cyan,green \"npm:preview\" \"npm:start:server\"",
    "start:server": "npm run start --workspace @factory/server",
    "build:client": "npm run build --workspace @factory/client",
    "build": "npm run build --workspace @factory/client && npm run typecheck --workspace @factory/server && npm run build --workspace @factory/server",
    "preview": "npm run preview --workspace @factory/client",
    "typecheck": "npm run typecheck --workspace @factory/client && npm run typecheck --workspace @factory/server && tsc -p tests && tsc -p bench",
    "test": "tsx --test \"tests/*.test.ts\"",
    "bench": "npm run bench:build && node bench/dist/run.js",
    "bench:build": "esbuild bench/run.ts --bundle --platform=node --format=esm --packages=external --target=node20 --outfile=bench/dist/run.js --log-level=warning",
    "bench:render": "tsx bench/render.ts",
    "bench:profile": "npm run bench:build && node --cpu-prof --cpu-prof-dir=bench/profiles bench/dist/run.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.8.0"
  },
  "allowScripts": {
    "node-datachannel": true
  }
}
