{
  "name": "@factory/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "npm run build && node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --target=node20 --sourcemap --outfile=dist/index.js"
  },
  "dependencies": {
    "@geckos.io/server": "^3.1.0"
  }
}
